---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="es" titulo="Página no encontrada" alternos={{ es: '/', en: '/en/' }}>
  <section class="seccion">
    <div class="contenedor no-encontrada">
      <h1 class="titulo">404</h1>
      <p class="texto-grande">La página que buscas no existe. / The page you are looking for does not exist.</p>
      <p><a class="boton" href="/">Ir al inicio</a> <a class="boton boton--borde" href="/en/">Go to home</a></p>
    </div>
  </section>
</Layout>
