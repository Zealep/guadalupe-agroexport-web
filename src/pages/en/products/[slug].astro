---
import ProductoDetalle from '../../../components/paginas/ProductoDetalle.astro';
import { productos } from '../../../data';

export function getStaticPaths() {
  return productos.map((producto) => ({ params: { slug: producto.en.slug }, props: { producto } }));
}

const { producto } = Astro.props;
---

<ProductoDetalle lang="en" producto={producto} />
