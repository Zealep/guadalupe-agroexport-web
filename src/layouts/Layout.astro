---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../i18n';
import { sitio, whatsappUrl } from '../data';

interface Props {
  lang: Lang;
  titulo: string;
  descripcion?: string;
  imagen?: string;
  // URL de esta misma página en cada idioma (para el selector ES | EN)
  alternos: { es: string; en: string };
  headerTransparente?: boolean;
}

const { lang, titulo, descripcion = t[lang].descripcion, imagen = '/img/sitio/hero.webp', alternos, headerTransparente = false } = Astro.props;
const tituloCompleto = titulo === sitio.nombre ? titulo : `${titulo} | ${sitio.nombre}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(alternos.es, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternos.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternos.es, Astro.site)} />
    <link rel="icon" type="image/png" href="/img/sitio/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta name="theme-color" content="#10662f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#contenido">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} alternos={alternos} transparente={headerTransparente} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
    <a class="wa-flotante" href={whatsappUrl(sitio.whatsapp)} target="_blank" rel="noopener" aria-label={t[lang].whatsapp}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.56.94.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43a9.4 9.4 0 0 1 9.42 9.44c0 5.2-4.23 9.43-9.44 9.43m8.03-17.47A11.28 11.28 0 0 0 12.05.7C5.8.7.7 5.79.7 12.05c0 2 .52 3.95 1.52 5.67L.6 23.3l5.72-1.5a11.33 11.33 0 0 0 5.72 1.46h.01c6.26 0 11.35-5.09 11.35-11.35 0-3.03-1.18-5.88-3.32-8.03"/></svg>
    </a>
  </body>
</html>
